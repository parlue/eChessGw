+void dispatchChesslinkBleLedFrameToBoard(BoardType type, const uint8_t frame167[167]) {
+  if (type != BoardType::Chessnut) {
+    dispatchLedFrameToBoard(type, frame167);
+    return;
+  }
+  SquareHighlight squares[64];
+  const size_t decoded = decodeKingLedFrame(frame167, squares, 64);
+  uint64_t fields=0, generic=0;
+  for (size_t i=0; i<decoded; ++i) {
+    const uint64_t bit=uint64_t(1)<<squares[i].squareIndex;
+    fields |= bit;
+    if (squares[i].role==SquareHighlightRole::Generic) generic |= bit;
+  }
+  char board[64];
+  const uint8_t* cached=cachedBoardStatusBytes();
+  if (cached) for (int s=0; s<64; ++s)
+    board[s]=static_cast<char>(cached[1+modeBStatusWireIndex(s%8,s/8+1)]);
+  const uint64_t resolved=chessnut_ble::normalize(fields,generic,cached ? board : nullptr);
+  size_t count=0;
+  for (int s=0; s<64; ++s) if ((resolved>>s)&1u)
+    squares[count++]={static_cast<uint8_t>(s),SquareHighlightRole::Generic};
+  Serial.printf("[CHESSNUT BT LED BETA1] decoded=%u resolved=%u:",
+                static_cast<unsigned>(decoded),static_cast<unsigned>(count));
+  for (size_t i=0; i<count; ++i)
+    Serial.printf(" %c%d",'a'+squares[i].squareIndex%8,squares[i].squareIndex/8+1);
+  Serial.println();
+  if (chessnutHasLocalDeviation()) {
+    chessnutDeferLedFrame(frame167,ChessnutLedOrigin::ChesslinkBle);
+    chessnutShowLocalBoardDeviations();
+  } else {
+    // One complete app frame replaces the previous display, including clear.
+    // Never enter the legacy Phoenix two-square accumulator.
+    chessnutSetHighlightedSquares(count ? squares : nullptr,count);
+  }
+}
